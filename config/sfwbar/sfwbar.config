Set Term = "foot"

placer {
  xstep = 5
  ystep = 5
}

include("winops.widget")

# Built-in scanner sources for CPU and memory monitoring
scanner {
  file("/proc/stat") {
    CpuUser = RegEx("^cpu [\\t ]*([0-9]+)", Sum)
    CpuNice = RegEx("^cpu [\\t ]*(?:[0-9]+ ){1}([0-9]+)", Sum)
    CpuSystem = RegEx("^cpu [\\t ]*(?:[0-9]+ ){2}([0-9]+)", Sum)
    CpuIdle = RegEx("^cpu [\\t ]*(?:[0-9]+ ){3}([0-9]+)", Sum)
  }
  
  file("/proc/meminfo") {
    MemTotal = RegEx("^MemTotal:[\\t ]*([0-9]+)")
    MemAvailable = RegEx("^MemAvailable:[\\t ]*([0-9]+)")
  }
}

# Calculate CPU utilization (0.0 to 1.0)
Set XCpuTotal = CpuUser + CpuNice + CpuSystem + CpuIdle
Set XCpuUtilization = If(XCpuTotal > 0, (CpuUser + CpuNice + CpuSystem) / XCpuTotal, 0)

# Calculate Memory utilization (0.0 to 1.0)
Set XMemUtilization = If(MemTotal > 0, 1 - (MemAvailable / MemTotal), 0)

# Scanner sources for external scripts
# Uncomment and configure as needed:
#
# scanner {
#   Exec("./scripts/cpu_load.sh") {
#     CpuLoad = Grab()
#   }
#   
#   Exec("./scripts/mem_used.sh") {
#     MemUsed = Grab()
#   }
#   
#   Exec("./scripts/cpu_temp.sh") {
#     CpuTemp = Grab()
#   }
#   
#   Exec("./scripts/gpu_info.sh") {
#     GpuInfo = Grab()
#   }
# }

layout "sfwbar" {
  include("startmenu.widget")

  pager {
    rows = 1
    pins = "1","2","3","4"
  }


    taskbar {
    style = "taskbar"
    rows = 1;
#   group = true
#   group cols = 1
#   group style = "taskbar_group"
#   group labels = true
#   group icons = true
    tooltips = true;
    icons = true;
    labels = true;
    sort = false;
    filter = workspace;
    action[3] = Menu "winops"
    action[Drag] = Focus
  }

  # Example custom labels using scanner variables:
  #
  # label {
  #   value = $CpuLoad
  #   style = "cpu"
  # }

  # Spacer - expands to push widgets to the right
  label { css = "* { -GtkWidget-hexpand: true; min-height: 30px; }" }

  # CPU monitoring with visual chart
  chart {
    interval = 1000
    style = "cpu_chart"
    value = XCpuUtilization
    tooltip = "CPU: " + Str(XCpuUtilization*100, 1) + "%"
  }

  # Memory monitoring with visual chart
  chart {
    interval = 1000
    style = "memory_chart"
    value = XMemUtilization
    tooltip = "Memory: " + Str(XMemUtilization*100, 1) + "%"
  }
  
tray {
  rows = 1
}

  widget "battery-svg.widget" {
# specify a battery device name or leave out to autodetect
#    device = 'BAT0'
  }
# widget "idle.widget"
#  widget "rfkill-wifi.widget"
#  widget "rfkill-bt.widget"
#  widget "upower.widget"
  widget "backlight.widget"
  widget "mpd-intmod.widget"
  widget "volume.widget"
  widget "bluez.widget"
  widget "network-module.widget"
  widget "ncenter.widget"
  widget "privacy.widget"
  widget "sway-lang.widget"
  widget "clock.widget" {
    time_format = "%H:%M:%S"
    tooltip_format = "%H:%M\n%x"
    week_starts_on_sunday = false
  }
}

#CSS
include("sfwbar.css")
